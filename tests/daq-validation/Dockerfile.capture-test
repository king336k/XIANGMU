FROM engram-daq-backend:latest
RUN rm -f /etc/apt/sources.list.d/* && apt-get -o Acquire::ForceIPv4=true -o Acquire::https::Timeout=20 update -qq && DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::ForceIPv4=true -o Acquire::https::Timeout=20 install -y --no-install-recommends libhdf5-dev nlohmann-json3-dev libopencv-dev libavformat-dev libavcodec-dev libavutil-dev pkg-config && rm -rf /var/lib/apt/lists/*

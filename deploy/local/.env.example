# 本地开发部署模板，不包含现有服务的凭据。
HTTP_PORT=18890
WEB_URL=http://localhost:18890
APP_DOMAIN=localhost
CORS_ALLOWED_ORIGINS=http://localhost:18890
POSTGRES_USER=engram
POSTGRES_DB=engramproject
POSTGRES_PASSWORD=replace-with-random-value
RABBITMQ_USER=engram
RABBITMQ_VHOST=engramproject
RABBITMQ_PASSWORD=replace-with-random-value
AWS_ACCESS_KEY_ID=engram-local
AWS_SECRET_ACCESS_KEY=replace-with-random-value
SECRET_KEY=replace-with-random-value
LIVE_SERVER_SECRET_KEY=replace-with-random-value
AWS_S3_BUCKET_NAME=uploads
FILE_SIZE_LIMIT=52428800
USE_MINIO=1
MINIO_ENDPOINT_SSL=0
DEBUG=0
QUALITY_BRIDGE_KEYS_JSON={}
KNOWLEDGE_LLM_ALLOWED_HTTP_ORIGINS=
# 仅启用独立Embedding时填写确切服务origin，例如 http://engramproject-embedding:18885
KNOWLEDGE_EMBEDDING_ALLOWED_HTTP_ORIGINS=
CERT_EMAIL=
CERT_ACME_CA=
CERT_ACME_DNS=

# 后台与诊断任务分队列；总诊断并行数为下面两项相乘
BACKGROUND_CONCURRENCY=2
DIAGNOSTIC_WORKERS=1
DIAGNOSTIC_CONCURRENCY=2

# 可选本地图片文字识别服务；不配置时不会发送原件
DOCUMENT_OCR_BASE_URL=
DOCUMENT_OCR_API_KEY=
DOCUMENT_OCR_ALLOWED_HTTP_ORIGINS=

# 内置知识检索由部署入口自动接通，日常不需在网页重复填写
KNOWLEDGE_BUILTIN_EMBEDDING_BASE_URL=
KNOWLEDGE_BUILTIN_EMBEDDING_API_KEY=
KNOWLEDGE_BUILTIN_EMBEDDING_MODEL=bge-small-zh-v1.5
